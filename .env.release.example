# Local release credentials for scripts/release-macos.sh (mac) and
# scripts/release-windows.ps1 (windows) — copy to `.env.release` (gitignored;
# NEVER commit the real one) and fill in what the platform you're releasing needs.

# ── macOS (release-macos.sh) ─────────────────────────────────────────────────
# Alternative (preferred, no secrets on disk): store a notarytool keychain
# profile once and skip these:
#   xcrun notarytool store-credentials photoblaze-notary \
#     --apple-id you@example.com --team-id TEAMID
#
# Notarization (an app-specific password from appleid.apple.com, NOT your Apple ID pw):
APPLE_ID=you@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XXXXXXXXXX

# Code signing: usually UNNEEDED locally — the script finds a "Developer ID
# Application" identity in your login keychain automatically. Only set these to
# import a .p12 into a throwaway keychain (the CI path):
# CSC_LINK=<base64 of the .p12>
# CSC_KEY_PASSWORD=...

# Optional: a different notarytool keychain-profile name (default: photoblaze-notary).
# NOTARY_PROFILE=photoblaze-notary

# ── Windows (release-windows.ps1) — Azure Trusted Signing ────────────────────
# Alternative (preferred, no secrets on disk): `az login` with an account holding
# the "Trusted Signing Certificate Profile Signer" role and skip these. The
# service principal needs that same role on the signing account.
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=...
