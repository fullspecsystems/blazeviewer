<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS bundle metadata for PhotoBlaze. Assembled into PhotoBlaze.app by
  scripts/bundle-macos.sh, which substitutes __SHORT_VERSION__ / __VERSION__ from
  the pb-app crate version. File associations (CFBundleDocumentTypes / UTI
  declarations) are added by task #6; this base plist makes the app launch as a
  normal, frontmost, menu-bar app.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>PhotoBlaze</string>
	<key>CFBundleDisplayName</key>
	<string>PhotoBlaze</string>
	<key>CFBundleIdentifier</key>
	<string>com.jdlien.PhotoBlaze</string>
	<key>CFBundleExecutable</key>
	<string>photoblaze</string>
	<!-- Modern (macOS 26 Tahoe / 27 Golden Gate): the Liquid Glass icon, compiled from
	     icons/AppIcon.icon into Assets.car by actool (see scripts/bundle-macos.sh).
	     CFBundleIconName resolves to the "AppIcon" entry in Assets.car. -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<!-- Legacy (pre-Tahoe): the flat PhotoBlaze.icns, used where Assets.car's layered
	     AppIcon isn't understood. -->
	<key>CFBundleIconFile</key>
	<string>PhotoBlaze</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>__SHORT_VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__VERSION__</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.photography</string>
	<!-- A normal foreground app (Dock icon + global menu bar), not an agent. -->
	<key>LSUIElement</key>
	<false/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHumanReadableCopyright</key>
	<string>© JD Lien</string>

	<!-- File associations (task #6). Declared with role Viewer and LSHandlerRank
	     Alternate: PhotoBlaze becomes a *candidate* "Open With" handler and can be set as
	     default by the user, but never silently seizes a default (mirrors the Windows
	     stance). The system already declares all these UTIs. Double-click / Dock-drop
	     delivers the files via `application:openURLs:`, which the app handles in
	     `macos_open.rs` (winit doesn't forward it). All these UTIs decode through
	     pb-decode; archives open via pb-source. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>CFBundleTypeIconFile</key>
			<string>PhotoBlaze</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.jpeg</string>
				<string>public.png</string>
				<string>public.heic</string>
				<string>public.heif</string>
				<string>public.avif</string>
				<string>com.compuserve.gif</string>
				<string>public.tiff</string>
				<string>com.microsoft.bmp</string>
				<string>com.microsoft.ico</string>
				<string>org.webmproject.webp</string>
				<string>public.jpeg-xl</string>
				<string>public.svg-image</string>
				<string>public.jpeg-2000</string>
				<string>com.truevision.tga-image</string>
				<string>public.camera-raw-image</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Image Archive</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>CFBundleTypeIconFile</key>
			<string>PhotoBlaze</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.zip-archive</string>
				<string>org.7-zip.7-zip-archive</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
