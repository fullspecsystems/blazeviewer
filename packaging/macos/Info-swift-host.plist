<?xml version="1.0" encoding="UTF-8"?>
<!--
  Bundle metadata for the SwiftUI host (ADR-021) — it IS the Mac app (cutover 2026-07-02).
  Assembled into "Blaze Viewer.app" by scripts/build-swift-host.sh (version placeholders
  from the pb-app crate version; icon assets copied into Resources).

  RENAMED 2026-07-14 (task #101): PhotoBlaze → Blaze Viewer, and the bundle id moved from
  com.jdlien.PhotoBlaze to ca.fullspec.BlazeViewer (reverse-DNS of the company domain
  fullspec.ca; four Swift dispatch-queue labels already used the ca.fullspec.* prefix).
  This is a DELIBERATE clean break: a new bundle id means macOS treats this as a new app,
  so the old file associations, TCC grants and Sparkle update continuity do NOT carry
  over. Accepted — the product is pre-release with a single user. Trash the old
  PhotoBlaze.app and run `lsregister -kill -r -domain local -domain user` to flush its
  stale LaunchServices associations.

  The name appears in three forms on purpose (see pb_app_core::APP_NAME/APP_IDENT):
  "Blaze Viewer" displays (spaces are the Mac convention — Visual Studio Code.app), while
  "BlazeViewer" is the space-free identifier used for the bundle id leaf and the DMG name.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Blaze Viewer</string>
	<key>CFBundleDisplayName</key>
	<string>Blaze Viewer</string>
	<key>CFBundleIdentifier</key>
	<string>ca.fullspec.BlazeViewer</string>
	<key>CFBundleExecutable</key>
	<string>Blaze Viewer</string>
	<!-- Modern (Tahoe+): the Liquid Glass icon from Assets.car; legacy: the flat icns —
	     the same prebuilt assets the egui bundle ships (packaging/macos/). -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIconFile</key>
	<string>BlazeViewer</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>__SHORT_VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__VERSION__</string>
	<!-- Git build stamp (short hash, -dirty when the tree had changes), shown in the
	     About panel as "Version X.Y.Z (hash)". Stamped by build-swift-host.sh; empty
	     for a build outside git (source tarball). -->
	<key>PBBuildID</key>
	<string>__BUILD_ID__</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.photography</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 FullSpec Systems Inc.</string>

	<!-- Sparkle auto-update (task #65). The app checks this EdDSA-signed appcast next to
	     the DMG on downloads.blazeviewer.app and, when a newer version is published, downloads
	     it in the background and installs on quit (the same UX Windows gets from Velopack).
	     SUPublicEDKey verifies the enclosure signature — a tampered/unsigned DMG is rejected.
	     The matching PRIVATE key lives only in the release Mac's login keychain (never
	     committed); the public key here is safe to ship. SUEnableAutomaticChecks /
	     SUAutomaticallyUpdate are just the first-launch DEFAULTS — the Settings ▸ General
	     ▸ Startup toggles override them and Sparkle persists the user's choice. Privacy #2:
	     an appcast GET carries only version + OS, never a viewing trace. -->
	<key>SUFeedURL</key>
	<string>https://downloads.blazeviewer.app/mac/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>1Fm8FpIfRApW1x2C/HFdSGRLQqH4TJ4F9w9ntggzg3A=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>

	<!-- Local Network access (task #44): the AI image-description feature can send the
	     current photo to an OpenAI-compatible model server the user configures — typically
	     on this Mac (localhost) or their own LAN. macOS 15+ gates local-network connections
	     behind this permission; declaring it lets the system show a meaningful prompt on
	     first use. No network access happens unless the endpoint field in Settings ▸ AI is
	     non-empty — opening that tab probes it once (to fill the Model picker), and
	     Describe/Ask send the photo itself; nothing else in the app touches the network. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Blaze Viewer connects to the local AI model server you configure in Settings to describe images on your own machine or network.</string>

	<!-- File associations — the same Viewer/Alternate stance as the egui bundle (a
	     candidate "Open With" handler, never silently the default). Delivered via
	     application:open: (AppDelegate) → the classify-and-open path. JPEG-2000 is
	     deliberately absent (pb-decode doesn't support it). -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>CFBundleTypeIconFile</key>
			<string>BlazeViewer</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.jpeg</string>
				<string>public.png</string>
				<string>public.heic</string>
				<string>public.heif</string>
				<string>public.avif</string>
				<string>com.compuserve.gif</string>
				<string>public.tiff</string>
				<string>com.microsoft.bmp</string>
				<string>com.microsoft.ico</string>
				<string>org.webmproject.webp</string>
				<string>public.jpeg-xl</string>
				<string>public.svg-image</string>
				<string>com.truevision.tga-image</string>
				<string>public.camera-raw-image</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Image Archive</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>CFBundleTypeIconFile</key>
			<string>BlazeViewer</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.zip-archive</string>
				<string>org.7-zip.7-zip-archive</string>
			</array>
		</dict>
		<!-- Video containers the library lists (task #79) — same Viewer/Alternate
		     candidacy, never the default video player. One cross-platform recognition
		     list (pb_app_core::video::VideoContainer); playability is a runtime
		     property of the OS decoder set. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Video</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>CFBundleTypeIconFile</key>
			<string>BlazeViewer</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.mpeg-4</string>
				<string>com.apple.m4v-video</string>
				<string>com.apple.quicktime-movie</string>
				<string>org.matroska.mkv</string>
				<string>org.webmproject.webm</string>
				<string>public.avi</string>
				<string>com.microsoft.windows-media-wmv</string>
				<string>public.mpeg</string>
				<string>public.mpeg-2-transport-stream</string>
				<string>public.3gpp</string>
				<string>public.3gpp2</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
