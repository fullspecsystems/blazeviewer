# Rust build artifacts
/target
**/target/
**/*.rs.bk

# Release packaging output (DMGs, MSIs, checksums) from scripts/release-{macos.sh,windows.ps1}
/dist/

# Local vendored crates (a temporary `cargo vendor` of a dep with an unreleased fix). Not part
# of the build — deps resolve from crates.io — so keep it untracked AND out of the -dirty check:
# crates/pb-app/build.rs stamps the build `-dirty` on ANY `git status --porcelain` output,
# untracked paths included. (Safe to delete; it's stale once the dep is repointed to crates.io.)
/vendor/

# Locally-built FFmpeg (task #84 phase 7, scripts/build-ffmpeg-macos.sh): the source tree,
# object files, and installed LGPL dylibs bundled into the macOS .app. Reproducible from the
# pinned tarball — never committed (also kept out of the -dirty check, like /vendor/).
/third_party/

# Coverage / profiling output
*.profraw
*.profdata
/coverage
*.tracy

# Per-run performance logs (keypress->photon traces, A/B benchmark dumps)
perf-*.jsonl
/.taskmaster/reports
/bench-results

# OS cruft
.DS_Store
Thumbs.db

# NOTE: Cargo.lock IS committed — this workspace produces a binary, so we want
# reproducible builds.

# Local release credentials (release-macos.sh / release-windows.ps1 source this; see .env.release.example)
.env.release

# Local scratch/smoke-test image sets (generated, not the pinned benchmark corpus)
scratch-corpus/

# Per-machine Claude Code settings (tool permissions), written by the tool as you work.
# Ignored HERE rather than relying on a user's global excludesfile, because the clean-tree
# gate runs inside the AppImage build container (scripts/release-linux-docker.sh), where
# $HOME is not mounted and global git config is invisible — so a file ignored on the host
# still shows as `?? ` in the container and aborts the release. Repo-local rules travel
# with the repo; personal ones do not. (Hit on 0.3.0, 2026-07-19: macOS built clean and
# Linux refused, same tree, minutes apart.)
.claude/settings.local.json
